# VR code of the client DLL: object lists, libraries and rules. Included by Makefile.hl_cdll, which sets VR_GAME
# (the per-game data file cl_dll/vr/VRGameClient_<game>.cpp) before the include.
# New files in cl_dll/vr or game_shared/vr are added here, not in Makefile.hl_cdll.

# The rules below come before the including Makefile's first target
.DEFAULT_GOAL := all

VR_OBJ_DIR=$(HL1_OBJ_DIR)/vr

# VGUI2 SDK subset for the VR Options dialog (external/hl1_source_sdk/README_BSVR.md). Its files and VRClientVGUI.cpp
# are built with the SDK's include paths and defines instead of the game's (both have interface.h, FileSystem.h, ...).
# The SDK uses SSE intrinsics, so -msse2 overrides -mno-sse from ARCH_CFLAGS.
SDK_DIR=$(SOURCE_DIR)/external/hl1_source_sdk
SDK_OBJ_DIR=$(HL1_OBJ_DIR)/hl1_source_sdk
SDK_INCLUDEDIRS=-I$(SDK_DIR)/common -I$(SDK_DIR)/public -I$(SDK_DIR)/public/tier0 -I$(SDK_DIR)/public/tier1
SDK_CFLAGS=$(BASE_CFLAGS) $(ARCH_CFLAGS) -msse2 -fexceptions -DNO_MALLOC_OVERRIDE -DMATHLIB_HEADER_ONLY -D_DLL_EXT=.so -DSOURCE_SDK_GFX_PATH=\"gfx/vgui2\" -DNO_STEAM
SDK_DO_CC=mkdir -p $(dir $@) && $(CPLUS) $(SDK_INCLUDEDIRS) $(SDK_CFLAGS) -o $@ -c $<
SDK_FORCED_INCLUDES=-include $(SDK_DIR)/vgui_controls_forced_includes.h

# -Bsymbolic: client.so uses its own globals even when a library loaded earlier exports the same name.
# vr_gl.cpp has GL function pointers named like the functions libGL exports (glGenerateMipmap, ...); without it
# they bind to libGL's code, which then gets overwritten.
VR_LDFLAGS=-Wl,-Bsymbolic
VR_LIBS=libopenvr_api.so -lGL $(SDK_DIR)/lib/public/libtier0.so $(SDK_DIR)/lib/public/libvstdlib.so

VR_OBJS = \
	$(HL1_OBJ_DIR)/vr/Matrices.o \
	$(HL1_OBJ_DIR)/vr/VRCommon.o \
	$(HL1_OBJ_DIR)/vr/VRCvarCache.o \
	$(HL1_OBJ_DIR)/vr/VRHelper.o \
	$(HL1_OBJ_DIR)/vr/VRRandom.o \
	$(HL1_OBJ_DIR)/vr/VRClientDLLUnloadHandler.o \
	$(HL1_OBJ_DIR)/vr/VREngineInterceptor.o \
	$(HL1_OBJ_DIR)/vr/VREngineFuncSwaps.o \
	$(HL1_OBJ_DIR)/vr/VROpenGLInterceptor.o \
	$(HL1_OBJ_DIR)/vr/VRInput.o \
	$(HL1_OBJ_DIR)/vr/VRInputAction.o \
	$(HL1_OBJ_DIR)/vr/VRInputHLMenu.o \
	$(HL1_OBJ_DIR)/vr/VRInputHLWindow.o \
	$(HL1_OBJ_DIR)/vr/VRInputInteractHandlers.o \
	$(HL1_OBJ_DIR)/vr/VRInputMovementHandlers.o \
	$(HL1_OBJ_DIR)/vr/VRInputOtherHandlers.o \
	$(HL1_OBJ_DIR)/vr/VRInputPosesHandlers.o \
	$(HL1_OBJ_DIR)/vr/VRInputWeaponsHandlers.o \
	$(HL1_OBJ_DIR)/vr/VRSettings.o \
	$(HL1_OBJ_DIR)/vr/VRGameFunctions.o \
	$(HL1_OBJ_DIR)/vr/VRSteamworksManager.o \
	$(HL1_OBJ_DIR)/vr/VRStudioModelRenderer.o \
	$(HL1_OBJ_DIR)/vr/VRModExtraDataCacheHook.o \
	$(HL1_OBJ_DIR)/vr/VRSettingsPages.o \
	$(HL1_OBJ_DIR)/vr/VRClientVGUI.o \
	$(HL1_OBJ_DIR)/vr/VRClientVGUIExport.o \
	$(HL1_OBJ_DIR)/vr/VRClientPlayer.o \
	$(HL1_OBJ_DIR)/vr/VRIntermissionAndMenuRenderer.o \
	$(HL1_OBJ_DIR)/vr/VRHUDRenderer.o \
	$(HL1_OBJ_DIR)/vr/VRHudAmmo.o \
	$(HL1_OBJ_DIR)/vr/VRHudMessages.o \
	$(HL1_OBJ_DIR)/vr/VRWeaponWheel.o \
	$(HL1_OBJ_DIR)/vr/VRWeaponAnimation.o \
	$(HL1_OBJ_DIR)/vr/VRWeaponEvents.o \
	$(HL1_OBJ_DIR)/vr/VRRenderer.o \
	$(HL1_OBJ_DIR)/vr/VRTextureHelper.o \
	$(HL1_OBJ_DIR)/vr/VRGameClient_$(VR_GAME).o \
	$(HL1_OBJ_DIR)/vr/lodepng.o \
	$(HL1_OBJ_DIR)/vr/vr_gl.o

VR_GAME_SHARED_OBJS = \
	$(GAME_SHARED_OBJ_DIR)/vr/VRPMShared.o \
	$(GAME_SHARED_OBJ_DIR)/vr/VRWeaponsShared.o

SDK_OBJS = \
	$(SDK_OBJ_DIR)/public/filesystem_helpers.o \
	$(SDK_OBJ_DIR)/public/vgui_controls/vgui_controls.o \
	$(SDK_OBJ_DIR)/tier1/characterset.o \
	$(SDK_OBJ_DIR)/tier1/KeyValues.o \
	$(SDK_OBJ_DIR)/tier1/mempool.o \
	$(SDK_OBJ_DIR)/tier1/qsort_s.o \
	$(SDK_OBJ_DIR)/tier1/strtools.o \
	$(SDK_OBJ_DIR)/tier1/strtools_unicode.o \
	$(SDK_OBJ_DIR)/tier1/tier1.o \
	$(SDK_OBJ_DIR)/tier1/utlbuffer.o \
	$(SDK_OBJ_DIR)/tier1/utlstring.o \
	$(SDK_OBJ_DIR)/tier1/utlsymbol.o \
	$(SDK_OBJ_DIR)/tier2/KeyValuesCompat.o \
	$(SDK_OBJ_DIR)/tier2/steam_api.o \
	$(SDK_OBJ_DIR)/tier2/tier2.o \
	$(SDK_OBJ_DIR)/vgui_controls/AnimatingImagePanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/AnimationController.o \
	$(SDK_OBJ_DIR)/vgui_controls/BitmapImagePanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/BuildFactoryHelper.o \
	$(SDK_OBJ_DIR)/vgui_controls/BuildGroup.o \
	$(SDK_OBJ_DIR)/vgui_controls/BuildModeDialog.o \
	$(SDK_OBJ_DIR)/vgui_controls/Button.o \
	$(SDK_OBJ_DIR)/vgui_controls/CheckButton.o \
	$(SDK_OBJ_DIR)/vgui_controls/ComboBox.o \
	$(SDK_OBJ_DIR)/vgui_controls/controls.o \
	$(SDK_OBJ_DIR)/vgui_controls/Divider.o \
	$(SDK_OBJ_DIR)/vgui_controls/EditablePanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/ExpandButton.o \
	$(SDK_OBJ_DIR)/vgui_controls/FocusNavGroup.o \
	$(SDK_OBJ_DIR)/vgui_controls/Frame.o \
	$(SDK_OBJ_DIR)/vgui_controls/GraphPanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/Image.o \
	$(SDK_OBJ_DIR)/vgui_controls/ImageList.o \
	$(SDK_OBJ_DIR)/vgui_controls/ImagePanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/Label.o \
	$(SDK_OBJ_DIR)/vgui_controls/ListPanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/ListViewPanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/MenuBar.o \
	$(SDK_OBJ_DIR)/vgui_controls/MenuButton.o \
	$(SDK_OBJ_DIR)/vgui_controls/Menu.o \
	$(SDK_OBJ_DIR)/vgui_controls/MenuItem.o \
	$(SDK_OBJ_DIR)/vgui_controls/MessageBox.o \
	$(SDK_OBJ_DIR)/vgui_controls/Panel.o \
	$(SDK_OBJ_DIR)/vgui_controls/PanelListPanel.o \
	$(SDK_OBJ_DIR)/vgui_controls/ProgressBar.o \
	$(SDK_OBJ_DIR)/vgui_controls/PropertyDialog.o \
	$(SDK_OBJ_DIR)/vgui_controls/PropertyPage.o \
	$(SDK_OBJ_DIR)/vgui_controls/PropertySheet.o \
	$(SDK_OBJ_DIR)/vgui_controls/RadioButton.o \
	$(SDK_OBJ_DIR)/vgui_controls/RichText.o \
	$(SDK_OBJ_DIR)/vgui_controls/ScrollBar.o \
	$(SDK_OBJ_DIR)/vgui_controls/ScrollBarSlider.o \
	$(SDK_OBJ_DIR)/vgui_controls/Slider.o \
	$(SDK_OBJ_DIR)/vgui_controls/TextEntry.o \
	$(SDK_OBJ_DIR)/vgui_controls/TextImage.o \
	$(SDK_OBJ_DIR)/vgui_controls/ToggleButton.o \
	$(SDK_OBJ_DIR)/vgui_controls/Tooltip.o \
	$(SDK_OBJ_DIR)/vgui_controls/ToolWindow.o \
	$(SDK_OBJ_DIR)/vgui_controls/TreeView.o \
	$(SDK_OBJ_DIR)/vgui_controls/TreeViewListControl.o \
	$(SDK_OBJ_DIR)/vgui_controls/URLLabel.o \

$(VR_OBJ_DIR):
	mkdir -p $(VR_OBJ_DIR)

# Built with the VGUI2 SDK's headers, see SDK_DIR
$(HL1_OBJ_DIR)/vr/VRClientVGUI.o: $(HL_SRC_DIR)/vr/VRClientVGUI.cpp
	$(SDK_DO_CC)

$(SDK_OBJ_DIR)/tier1/%.o: $(SDK_DIR)/tier1/%.cpp
	$(SDK_DO_CC) -DTIER1_STATIC_LIB

$(SDK_OBJ_DIR)/tier2/%.o: $(SDK_DIR)/tier2/%.cpp
	$(SDK_DO_CC)

$(SDK_OBJ_DIR)/vgui_controls/%.o: $(SDK_DIR)/vgui2/vgui_controls/%.cpp
	$(SDK_DO_CC) $(SDK_FORCED_INCLUDES)

$(SDK_OBJ_DIR)/public/%.o: $(SDK_DIR)/public/%.cpp
	$(SDK_DO_CC) $(SDK_FORCED_INCLUDES)

$(HL1_OBJ_DIR)/vr/%.o: $(HL_SRC_DIR)/vr/%.cpp $(filter-out $(wildcard  $(VR_OBJ_DIR)),  $(VR_OBJ_DIR))
	$(DO_CC)

